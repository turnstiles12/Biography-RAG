    "pg": "8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "unpdf": "2.2.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
