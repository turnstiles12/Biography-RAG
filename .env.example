# ---------- Required ----------
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
# Public HTTPS origin of the site (used for CORS, CSRF origin checks, cookies, metadata).
# Also pass it as a Docker build arg (see README).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side LLM key. Leave empty to make every visitor bring their own key (BYOK).
ANTHROPIC_API_KEY=

# ---------- LLM ----------
LLM_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
EXTRACT_EFFORT=low
STORY_EFFORT=medium
JUDGE_EFFORT=medium
# Server-side refusal fallback (Anthropic re-runs a declined request on its recommended model)
LLM_FALLBACKS=true
LLM_CONCURRENCY=4
ALLOW_BYOK=true

# ---------- Embeddings ----------
# local = ONNX model on the server CPU (no key, no cost). openai = text-embedding-3-small at 384 dims.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_POOLING=cls
MODEL_CACHE_DIR=./.models
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Chunking & retrieval ----------
CHUNK_TOKENS=500
CHUNK_OVERLAP=100
PAGE_CHARS=2000
TOP_K=6
CANDIDATE_K=30
# Cosine-similarity gate; below it a query abstains without calling the LLM.
MIN_SIMILARITY=0.5

# ---------- Upload caps ----------
MAX_FILES_PER_UPLOAD=50
MAX_FILE_MB=20
MAX_UPLOAD_MB=60
MAX_PAGES_PER_WORKSPACE=3000
MAX_CHUNKS_PER_WORKSPACE=6000

# ---------- Rate limits (per client IP) ----------
TRUST_PROXY=true
# Number of reverse proxies in front of the app (Caddy/Nginx = 1; Cloudflare + Nginx = 2).
TRUSTED_PROXY_HOPS=1
RL_API_PER_MINUTE=120
RL_WORKSPACES_PER_DAY=10
RL_UPLOADS_PER_HOUR=10
RL_RUNS_PER_DAY=3
RL_RUNS_PER_DAY_BYOK=30
RL_CANARY_PER_HOUR=15
RL_CANARY_PER_HOUR_BYOK=100
# Total full runs per day on the server key, across all visitors (cost ceiling).
GLOBAL_SERVER_KEY_RUNS_PER_DAY=50

# ---------- Housekeeping ----------
DEMO_WORKSPACE_ID=demo-benjamin-franklin
# Idle non-demo workspaces are deleted after this many days (0 = never).
WORKSPACE_TTL_DAYS=30
AUTO_MIGRATE=true
# PG_SSL=true          # for managed Postgres that requires TLS
# PG_POOL_MAX=10
